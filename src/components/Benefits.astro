  <div class="mx-auto max-w-7xl">
    <!-- Encabezado -->
    <div class="grid gap-10 md:grid-cols-[1fr_2fr] md:items-end">
      <div class="flex items-center gap-4">
        <span class="h-px w-12 bg-[#6D28D9]"></span>

        <span
          class="font-[Inter] text-xs font-medium uppercase
                 tracking-[0.3em] text-[#6D28D9]"
