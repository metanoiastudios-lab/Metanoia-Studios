<section
  id="proceso"
  class="relative overflow-hidden bg-[#0D0B12] px-6 py-28 md:py-40"
>
  <div class="mx-auto max-w-7xl">
    <!-- Encabezado -->
    <div class="grid gap-10 md:grid-cols-[1fr_2fr] md:items-end">
      <div class="flex items-center gap-4">
        <span class="h-px w-12 bg-[#8B5CF6]"></span>

        <span
          class="font-[Inter] text-xs font-medium uppercase
                 tracking-[0.3em] text-[#8B5CF6]"
        >
          Nuestro proceso
        </span>
      </div>

      <h2
        class="max-w-4xl font-[Space_Grotesk] text-5xl font-semibold
               leading-[0.95] tracking-tight text-[#F5F3FF]
               md:text-7xl lg:text-8xl"
      >
        Una buena web
        <span class="text-[#8B5CF6]"> empieza mucho antes del código. </span>
      </h2>
    </div>

    <!-- Línea de proceso -->
    <div class="relative mt-24 md:mt-32">
      <!-- Línea vertical -->
      <div
        class="absolute left-[11px] top-0 h-full w-px
               bg-white/10 md:left-1/2"
      >
      </div>

      <!-- 01 -->
      <article class="relative grid gap-8 pb-24 md:grid-cols-2 md:gap-20">
        <div class="md:text-right md:pr-20">
          <span
            class="font-[Space_Grotesk] text-7xl font-semibold
                   leading-none text-white/10 md:text-8xl"
          >
            01
          </span>
        </div>

        <div class="relative pl-10 md:pl-20">
          <div
            class="absolute left-[-4px] top-2 h-6 w-6 rounded-full
                   border-4 border-[#0D0B12] bg-[#8B5CF6]
                   shadow-[0_0_25px_rgba(139,92,246,0.5)]
                   md:left-[-12px]"
          >
          </div>

          <h3
            class="font-[Space_Grotesk] text-3xl font-semibold
                   text-[#F5F3FF] md:text-4xl"
          >
            Hablamos.
          </h3>

          <p
            class="mt-4 max-w-lg font-[Inter] text-base
                   leading-relaxed text-[#918CA3] md:text-lg"
          >
            Conocemos tu negocio, lo que haces y lo que quieres transmitir.
            Antes de diseñar, entendemos.
          </p>
        </div>
      </article>

      <!-- 02 -->
      <article class="relative grid gap-8 pb-24 md:grid-cols-2 md:gap-20">
        <div class="order-2 pl-10 md:order-1 md:pl-20">
          <div
            class="absolute left-[-4px] top-2 h-6 w-6 rounded-full
                   border-4 border-[#0D0B12] bg-[#8B5CF6]
                   shadow-[0_0_25px_rgba(139,92,246,0.5)]
                   md:left-1/2 md:-translate-x-1/2"
          >
          </div>

          <h3
            class="font-[Space_Grotesk] text-3xl font-semibold
                   text-[#F5F3FF] md:text-4xl"
          >
            Diseñamos.
          </h3>

          <p
            class="mt-4 max-w-lg font-[Inter] text-base
                   leading-relaxed text-[#918CA3] md:text-lg"
          >
            Convertimos la esencia de tu negocio en una experiencia visual
            clara, moderna y pensada para tus clientes.
          </p>
        </div>

        <div class="order-1 md:order-2 md:pl-20">
          <span
            class="font-[Space_Grotesk] text-7xl font-semibold
                   leading-none text-white/10 md:text-8xl"
          >
            02
          </span>
        </div>
      </article>

      <!-- 03 -->
      <article class="relative grid gap-8 pb-24 md:grid-cols-2 md:gap-20">
        <div class="md:text-right md:pr-20">
          <span
            class="font-[Space_Grotesk] text-7xl font-semibold
                   leading-none text-white/10 md:text-8xl"
          >
            03
          </span>
        </div>

        <div class="relative pl-10 md:pl-20">
          <div
            class="absolute left-[-4px] top-2 h-6 w-6 rounded-full
                   border-4 border-[#0D0B12] bg-[#8B5CF6]
                   shadow-[0_0_25px_rgba(139,92,246,0.5)]
                   md:left-[-12px]"
          >
          </div>

          <h3
            class="font-[Space_Grotesk] text-3xl font-semibold
                   text-[#F5F3FF] md:text-4xl"
          >
            Desarrollamos.
          </h3>

          <p
            class="mt-4 max-w-lg font-[Inter] text-base
                   leading-relaxed text-[#918CA3] md:text-lg"
          >
            Hacemos realidad el diseño con una web rápida, funcional y adaptada
            a cualquier dispositivo.
          </p>
        </div>
      </article>

      <!-- 04 -->
      <article class="relative grid gap-8 md:grid-cols-2 md:gap-20">
        <div class="order-2 pl-10 md:order-1 md:pl-20">
          <div
            class="absolute left-[-4px] top-2 h-6 w-6 rounded-full
                   border-4 border-[#0D0B12] bg-[#8B5CF6]
                   shadow-[0_0_25px_rgba(139,92,246,0.5)]
                   md:left-1/2 md:-translate-x-1/2"
          >
          </div>

          <h3
            class="font-[Space_Grotesk] text-3xl font-semibold
                   text-[#F5F3FF] md:text-4xl"
          >
            Publicamos.
          </h3>

          <p
            class="mt-4 max-w-lg font-[Inter] text-base
                   leading-relaxed text-[#918CA3] md:text-lg"
          >
            Ponemos tu sitio en internet y dejamos tu negocio listo para que tus
            clientes puedan encontrarte.
          </p>
        </div>

        <div class="order-1 md:order-2 md:pl-20">
          <span
            class="font-[Space_Grotesk] text-7xl font-semibold
                   leading-none text-white/10 md:text-8xl"
          >
            04
          </span>
        </div>
      </article>
    </div>
  </div>
</section>
