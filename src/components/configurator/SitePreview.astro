    <div class="mx-auto h-8 w-56 rounded-lg bg-white/80"></div>

    <div class="mx-auto mt-8 h-12 w-40 rounded-full bg-[#8B5CF6]"></div>
  </section>

  <!-- Contact -->
  <section
    data-preview-section="contact"
    class="border-t border-white/10 px-8 py-20"
