    <div class="grid gap-8 md:grid-cols-2">
      <div>
        <div class="h-8 w-48 rounded-lg bg-white/80"></div>

        <div class="mt-6 space-y-3">
          <div class="h-3 w-48 rounded-full bg-white/20"></div>
          <div class="h-3 w-64 rounded-full bg-white/20"></div>
        </div>
      </div>

      <div class="h-48 rounded-2xl bg-white/[0.06]"></div>
    </div>
  </section>

  <!-- Map -->
  <section
    data-preview-section="map"
    class="border-t border-white/10 px-8 py-20"
