<div
  id="site-preview"
  class="overflow-hidden rounded-3xl border border-white/10 bg-[#17141F] shadow-2xl"
>
  <!-- Preview Navbar -->
  <div
    class="flex items-center justify-between border-b border-white/10 px-6 py-5"
  >
    <div class="h-4 w-28 rounded-full bg-white/80"></div>

    <div class="hidden gap-3 sm:flex">
      <div class="h-2 w-10 rounded-full bg-white/20"></div>
      <div class="h-2 w-10 rounded-full bg-white/20"></div>
      <div class="h-2 w-10 rounded-full bg-white/20"></div>
    </div>
  </div>

  <!-- Hero -->
  <section
    data-preview-section="hero"
    class="flex min-h-[420px] flex-col items-center justify-center px-8 text-center"
  >
    <div class="relative mb-5 flex items-center justify-center">
      <!-- Halo -->
      <div
        class="absolute left-1/2 top-1/2
           h-10 w-10 -translate-x-1/2 -translate-y-1/2
           rounded-full bg-[#fff]/30 blur-xl
           md:h-30 md:w-30"
      >
      </div>

      <!-- Logo -->
      <img
        src="src/assets/logo.svg"
        alt="Metanoia Studios"
        class="h-[10rem] relative z-10 w-[22rem] max-w-[55vw] md:w-[32rem]"
      />
    </div>

    <p
      class="max-w-2xl font-[Inter] text-lg leading-relaxed text-[#F5F3FF] md:text-xl"
    >
      Diseñamos sitios web que hacen que tu negocio se vea tan bien como
      realmente es.
    </p>

    <div class="mt-4 h-6 w-1/2 max-w-md rounded-full bg-white/20">
      <p>evoluciona con tu negocio</p>
    </div>

    <div class="mt-8 h-12 w-42 rounded-full bg-[#8B5CF6]">
      <p
        class="max-w-2xl font-[Inter] text-lg leading-relaxed text-[#F5F3FF] md:text-xl mt-2"
      >
        CONTACTANOS
      </p>
    </div>
  </section>

  <!-- About -->
  <section
    data-preview-section="about"
    class="border-t border-white/10 px-8 py-20"
  >
    <div class="grid gap-8 md:grid-cols-2">
      <div>
        <div class="h-15 w-32 rounded-full bg-[#8B5CF6]/50 pl-5">
          <span
            class="font-[Inter] text-xs font-medium uppercase
               tracking-[0.3em] text-[#fff]"
          >
            Sobre Metanoia
          </span>
        </div>

        <h2
          class="mt-6 font-[Space_Grotesk] text-5xl font-semibold
               leading-[0.95] tracking-tight text-[#F5F3FF]
               md:text-7xs lg:text-8xs"
        >
          Tu negocio ya tiene una historia.
        </h2>
      </div>

      <div class="space-y-3">
        <div class="h-3 w-full rounded-full bg-white/20">
          <p
            class="font-[Inter] text-xl leading-relaxed
                 text-[#F5F3FF] md:text-3s"
          >
            Transformamos ideas y negocios en experiencias digitales claras,
            modernas y funcionales.
          </p>
        </div>
        <div class="h-3 w-5/6 rounded-full bg-white/20"></div>
        <div class="h-3 w-4/6 rounded-full bg-white/20"></div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section
    data-preview-section="services"
    class="border-t border-white/10 px-8 py-20"
  >
    <div class="h-8 w-48 rounded-lg bg-white/80"></div>

    <div class="mt-8 grid gap-4 sm:grid-cols-3">
      <div class="h-32 rounded-2xl bg-white/[0.06]"></div>
      <div class="h-32 rounded-2xl bg-white/[0.06]"></div>
      <div class="h-32 rounded-2xl bg-white/[0.06]"></div>
    </div>
  </section>

