      <div class="flex justify-between border-b border-white/10 pb-4">
        <div class="h-3 w-32 rounded-full bg-white/30"></div>
        <div class="h-3 w-16 rounded-full bg-[#8B5CF6]/60"></div>
      </div>
    </div>
