    <div class="h-64 rounded-2xl bg-white/[0.06]">
      <div class="flex h-full items-center justify-center">
        <div class="h-10 w-10 rounded-full bg-[#8B5CF6]"></div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t border-white/10 px-8 py-10">
    <div class="h-3 w-32 rounded-full bg-white/40"></div>
  </footer>
