    <div class="h-8 w-48 rounded-lg bg-white/80"></div>

    <div class="mt-8 grid grid-cols-2 gap-4 md:grid-cols-3">
      <div class="aspect-square rounded-2xl bg-white/[0.06]"></div>
      <div class="aspect-square rounded-2xl bg-white/[0.06]"></div>
      <div class="aspect-square rounded-2xl bg-white/[0.06]"></div>
      <div class="aspect-square rounded-2xl bg-white/[0.06]"></div>
      <div class="aspect-square rounded-2xl bg-white/[0.06]"></div>
      <div class="aspect-square rounded-2xl bg-white/[0.06]"></div>
    </div>
  </section>

  <!-- Testimonials -->
  <section
    data-preview-section="testimonials"
    class="border-t border-white/10 px-8 py-20"
  >
    <div class="h-8 w-56 rounded-lg bg-white/80"></div>

    <div class="mt-8 rounded-2xl bg-white/[0.06] p-8">
      <div class="h-3 w-full rounded-full bg-white/20"></div>
      <div class="mt-3 h-3 w-4/5 rounded-full bg-white/20"></div>
      <div class="mt-6 h-3 w-32 rounded-full bg-[#8B5CF6]/50"></div>
    </div>
  </section>

  <!-- Reservations -->
  <section
    data-preview-section="reservations"
    class="border-t border-white/10 px-8 py-20 text-center"
