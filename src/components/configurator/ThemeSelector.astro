<section class="rounded-3xl border border-white/10 bg-white/[0.03] p-6">
  <div>
    <span
      class="font-[Inter] text-xs font-medium uppercase tracking-[0.25em] text-[#8B5CF6]"
    >
      Paso 03
    </span>

    <h2 class="mt-3 font-[Space_Grotesk] text-2xl font-semibold text-[#F5F3FF]">
      Elige un estilo
    </h2>
  </div>

  <div class="mt-6 grid grid-cols-3 gap-3">
    <button
      type="button"
      data-theme="dark"
      class="theme-option rounded-2xl border border-[#8B5CF6] bg-[#8B5CF6]/10 p-4 text-center"
    >
      <div
        class="mx-auto h-8 w-8 rounded-full bg-[#0D0B12] ring-1 ring-white/20"
      >
      </div>

      <span class="mt-3 block font-[Inter] text-xs"> Dark </span>
    </button>

    <button
      type="button"
      data-theme="light"
      class="theme-option rounded-2xl border border-white/10 p-4 text-center transition hover:border-[#8B5CF6]/50"
    >
      <div
        class="mx-auto h-8 w-8 rounded-full bg-[#F5F3FF] ring-1 ring-white/20"
      >
      </div>

      <span class="mt-3 block font-[Inter] text-xs"> Light </span>
    </button>

    <button
      type="button"
      data-theme="violet"
      class="theme-option rounded-2xl border border-white/10 p-4 text-center transition hover:border-[#8B5CF6]/50"
    >
      <div class="mx-auto h-8 w-8 rounded-full bg-[#6D28D9]"></div>

      <span class="mt-3 block font-[Inter] text-xs"> Violet </span>
    </button>
  </div>
</section>
