      <span class="font-[Inter] text-sm"> Sobre nosotros </span>

      <input
        type="checkbox"
        data-section="about"
        checked
        class="h-4 w-4 accent-[#8B5CF6]"
      />
    </label>

    <!-- Services -->
    <label
      class="flex cursor-pointer items-center justify-between rounded-xl border border-white/10 px-4 py-4 transition hover:bg-white/[0.04]"
