<section class="rounded-3xl border border-white/10 bg-white/[0.03] p-6">
  <div>
    <span
      class="font-[Inter] text-xs font-medium uppercase tracking-[0.25em] text-[#8B5CF6]"
    >
      Paso 02
    </span>

    <h2 class="mt-3 font-[Space_Grotesk] text-2xl font-semibold text-[#F5F3FF]">
      ¿Qué quieres en tu sitio?
    </h2>
  </div>

  <div class="mt-6 space-y-2">
    <!-- Hero -->
    <label
      class="flex cursor-pointer items-center justify-between rounded-xl border border-white/10 px-4 py-4 transition hover:bg-white/[0.04]"
    >
      <span class="font-[Inter] text-sm"> Hero / Inicio </span>

      <input
        type="checkbox"
        data-section="hero"
        checked
        disabled
        class="h-4 w-4 accent-[#8B5CF6]"
      />
    </label>

    <!-- About -->
    <label
      class="flex cursor-pointer items-center justify-between rounded-xl border border-white/10 px-4 py-4 transition hover:bg-white/[0.04]"
