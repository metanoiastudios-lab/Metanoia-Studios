<section
  id="contacto"
  class="relative overflow-hidden bg-[#0D0B12] px-6 py-32
         md:py-48"
>
  <!-- Halo principal -->
  <div
    class="pointer-events-none absolute left-1/2 top-1/2
           h-[30rem] w-[30rem] -translate-x-1/2 -translate-y-1/2
           rounded-full bg-[#6D28D9]/20 blur-[120px]
           md:h-[45rem] md:w-[45rem]"
  >
  </div>

  <div
    class="relative mx-auto flex max-w-5xl flex-col
           items-center text-center"
  >
    <!-- Etiqueta -->
    <div class="flex items-center gap-4">
      <span class="h-px w-10 bg-[#8B5CF6]"></span>

      <span
        class="font-[Inter] text-xs font-medium uppercase
               tracking-[0.3em] text-[#C4B5FD]"
      >
        Hablemos
      </span>

      <span class="h-px w-10 bg-[#8B5CF6]"></span>
    </div>

    <!-- Título -->
    <h2
      class="mt-10 font-[Space_Grotesk] text-5xl font-semibold
             leading-[0.95] tracking-tight text-[#F5F3FF]
             md:text-7xl lg:text-8xl"
    >
      Tu negocio merece
      <span class="text-[#8B5CF6]"> verse así. </span>
    </h2>

    <!-- Descripción -->
    <p
      class="mt-8 max-w-2xl font-[Inter] text-lg leading-relaxed
             text-[#918CA3] md:text-xl"
    >
      Cuéntanos qué haces, qué necesitas y qué quieres transmitir. Nosotros nos
      encargamos de convertirlo en una experiencia digital.
    </p>

    <!-- Botón -->
    <a
      href="/configurator"
      class="group mt-12 inline-flex items-center gap-4
             rounded-full bg-[#8B5CF6] px-7 py-4
             font-[Inter] text-sm font-medium text-white
             transition duration-300
             hover:bg-[#6D28D9]
             hover:shadow-[0_0_40px_rgba(139,92,246,0.3)]"
    >
      Empecemos

      <span
        class="text-lg transition-transform duration-300
               group-hover:translate-x-1"
      >
        →
      </span>
    </a>
  </div>
</section>
